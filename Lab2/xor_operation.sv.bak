module xor_operation 
	#(parameter N = 8) 
	(
		input logic [N-1:0] a,
		input logic [N-1:0] b,
		
		output logic [N-1:0] result,
		output logic [3:0] flags
	);
    
    assign result = a ^ b;
	 
    assign flags[0] = (result == 0);
    assign flags[1] = result[N-1];
    assign flags[2] = 0; // XOR no genera acarreo
    assign flags[3] = 0; // XOR no genera desbordamiento
    
endmodule
