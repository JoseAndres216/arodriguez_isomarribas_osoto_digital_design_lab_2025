module shift_left #(parameter N = 4)(
    input logic [N-1:0] a, 
    input logic [N-1:0] b,
    output logic [N-1:0] result,
    output logic [3:0] flags
);

    always_comb begin
        // Operación de desplazamiento a la izquierda
        result = a << b;

        // Asignación de los flags dentro del bloque procedural
        flags[0] = 0;  // Negative flag (no aplica en este caso)
        flags[1] = ~|result; // Zero flag: se activa si todos los bits de 'result' son 0
        flags[2] = (b != 0) && ((a & (1 << (N - b))) != 0); // Carry flag: se activa si un bit alto se desplaza fuera
        flags[3] = (b >= N); // Overflow flag: se activa si el desplazamiento excede el tamaño de N
    end

endmodule