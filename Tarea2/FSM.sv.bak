module FSM (
	input logic clk, rst, m,
	output logic [7:0] mCounter, cicles_skipped

);


logic [1:0] state, next_state;


//logica de estado actual
always_ff @ (posedge clk or posedge rst)
	if (rst) 
		state = 2'b00;
	else
		state = next_state;

//logica del siguiente estado
always_comb
	case(state)
		2'b00: if(m) next_state = 2'b01; else next_state = 2'b10;
		2'b01: next_state = 2'b00;
		2'b10: next_state = 2'b10; // llamar contador y decidir siquiente estado
		2'b11: next_state = 2'b11; // escribe el error y se encicla hasta que haya reset
		default: next_state = 2'b00;
	endcase

endmodule