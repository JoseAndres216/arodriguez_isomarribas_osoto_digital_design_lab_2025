.global _start
_start:
MAIN:
	SUB R0, R15, R15
	ADD     R2, R0, #6          @ R2 = 6
    STR     R2, [R0, #100]      @ M[100] = R2
	ADD     R3, R0, #9          @ R3 = 9
TEST:
	LDR     R2, [R0, #100]       @ R2 = M[100]
	SUBS 	R4, R2, R3			@ R4 = 10?
	BGE  	LED
	B		TEST
LED:
	ADD 	R5, R0, #7			@ R2 = 7
	STR     R5, [R0, #100]      @ M[100] = R2
LOOP:
	LDR     R5, [R0, #100]       @ R2 = M[100]
	B		LOOP