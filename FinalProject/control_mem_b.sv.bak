module control_mem_b(
    input  logic clk,
    input  logic timeOut,
    input  logic [31:0] ReadDataB,
    output logic MemWriteB,
    output logic [31:0] DataAdrB,
    output logic [31:0] WriteDataB,
    output logic led
);

    // Dirección fija de acceso (siempre dirección 100)
    assign DataAdrB = 32'd100;

    // Generación de las señales de escritura
    always_comb begin
        MemWriteB = 1'b0;
        WriteDataB = 32'd0;

        if (timeOut) begin
            MemWriteB = 1'b1;
            WriteDataB = 32'd9;
        end
    end

    // Control del LED (lógica síncrona)
    always_ff @(posedge clk) begin
        if (ReadDataB == 9)
            led <= 1;
        else
            led <= 0;
    end

endmodule