/**
 * @module connect4grid
 * @brief Generate a Connect 4 board grid on the VGA screen.
 *
 * @param x       Horizontal pixel position (0-639)
 * @param y       Vertical pixel position (0-479)
 * @param grid_on Output signal: high if the pixel is part of the board background
 * @param hole_on Output signal: high if the pixel is part of a hole
 */
module tableGrid(
    input logic [9:0] x, y,
    output logic grid_on,
    output logic hole_on
);

    // Tamaño de la zona de juego (puedes ajustar estos números)
    localparam GRID_LEFT   = 100;
    localparam GRID_TOP    = 50;
    localparam CELL_WIDTH  = 60;
    localparam CELL_HEIGHT = 60;
    localparam COLS = 7;
    localparam ROWS = 6;

    logic in_grid;
    logic [2:0] col;
    logic [2:0] row;
    logic [9:0] local_x, local_y;
    logic in_hole;

    // Verificar si estamos dentro de la zona de la tabla
    assign in_grid = (x >= GRID_LEFT) && (x < GRID_LEFT + COLS * CELL_WIDTH) &&
                     (y >= GRID_TOP)  && (y < GRID_TOP + ROWS * CELL_HEIGHT);

    // Coordenadas locales dentro del grid
    assign local_x = x - GRID_LEFT;
    assign local_y = y - GRID_TOP;

    // Determinar columna y fila
    assign col = local_x / CELL_WIDTH;
    assign row = local_y / CELL_HEIGHT;

    // Coordenadas locales dentro de una celda
    logic [9:0] cell_x, cell_y;
    assign cell_x = local_x % CELL_WIDTH;
    assign cell_y = local_y % CELL_HEIGHT;

    // Definir tamaño del agujero (más pequeño que la celda)
    localparam HOLE_RADIUS = 20;

    // Centro del agujero dentro de cada celda
    localparam CENTER_X = CELL_WIDTH/2;
    localparam CENTER_Y = CELL_HEIGHT/2;

    // Detectar si estamos dentro de un agujero (usar distancia euclidiana)
    assign in_hole = ((cell_x - CENTER_X)*(cell_x - CENTER_X) + 
                      (cell_y - CENTER_Y)*(cell_y - CENTER_Y)) <= (HOLE_RADIUS * HOLE_RADIUS);

    // Salidas
    assign grid_on = in_grid;
    assign hole_on = in_grid && in_hole;

endmodule
